# Copy to .env and fill in when ready to send real emails.
# Until these are set, contact form submissions are stored in data/submissions.jsonl
# and no emails are sent (this is logged, not an error).
#
# Raw SMTP doesn't work on most PaaS free tiers (outbound SMTP ports are
# commonly blocked), so this app sends via Resend's HTTPS API instead.
# Sign up at resend.com, verify your domain, and grab an API key.

RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=Matsi Counselling <hello@matsicounselling.com>
