# Copy to .env and fill in when ready to send real emails.
# Until these are set, contact form submissions are stored in data/submissions.jsonl
# and no emails are sent (this is logged, not an error).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=matsicounselling@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=matsicounselling@gmail.com
